# Copy to slurm/site.env (ignored by Git) and fill in your own paths.
# The job script sources this file on the compute node.

# Modules: ffmpeg is needed to read audio from mp4 files. Module names differ per cluster.
module purge
module load 2025 CUDA/12.8.0 FFmpeg/7.1.1-GCCcore-14.2.0

# Python of the virtual environment built from requirements.lock.txt
export OMNITALK_PYTHON=/path/to/venv/bin/python

# Directory holding the clips listed in data/clips_manifest.jsonl (default: data/clips in this repository)
# export OMNITALK_CLIPS_DIR=/path/to/clips

# Model weights. With HF_HUB_OFFLINE=1 the two checkpoints must already be in HF_HOME.
export HF_HOME=/path/to/hf_cache
export HF_HUB_OFFLINE=1

# Keep compile caches away from small home quotas.
export TRITON_CACHE_DIR=/path/to/scratch/triton_cache
export TORCHINDUCTOR_CACHE_DIR=/path/to/scratch/inductor_cache
export VLLM_CACHE_ROOT=/path/to/scratch/vllm_cache
export XDG_CACHE_HOME=/path/to/scratch/xdg_cache

# Required settings
export FORCE_QWENVL_VIDEO_READER=decord
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export TOKENIZERS_PARALLELISM=false
